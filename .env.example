# 管理后台登录密码（默认 admin123，生产环境请务必修改）
ADMIN_PASSWORD=admin123
JWT_SECRET=change-this-to-a-long-random-secret

# 数据库连接（默认使用本地文件 data/gallery.db，无需配置）
# DATABASE_URL=file:./data/gallery.db

# 可选：S3 兼容对象存储（支持 Cloudflare R2 / 阿里云 OSS / 火山 TOS / AWS S3）
# 不配置时默认存放在本地 data/uploads/ 目录并通过 /uploads/* 提供访问
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=my-gallery
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com
