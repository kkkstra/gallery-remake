# =========================================================
# 1. 基础安全配置（必填）
# =========================================================
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-to-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# =========================================================
# 2. 数据库配置（Turso 远程 LibSQL / 本地 SQLite）
#    - 本地或 VPS Docker：留空即可（默认使用 file:./data/gallery.db）
#    - Vercel 部署：填写 Turso 数据库地址与 Token
# =========================================================
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOiJFZERTQSIs...

# =========================================================
# 3. 图片对象存储配置（Cloudflare R2 / 阿里云 OSS / 火山 TOS / S3）
#    - 本地或 VPS Docker：可留空（默认存入 ./data/uploads）
#    - Vercel 部署：必填（已支持前端预签名直传 R2，突破 Vercel 4.5MB 限制）
# =========================================================
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=gallery
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_PUBLIC_URL=https://img.your-domain.com
